# Copy this file to .env and adjust as needed. Do not commit .env.

DATABASE_URL=sqlite:///./meetingai.db
WHISPER_MODEL=small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_UPLOAD_SIZE_MB=200

# Optional. Defaults shown.
# WHISPER_DEVICE=cpu            # set to cuda to use an NVIDIA GPU
# WHISPER_COMPUTE_TYPE=int8     # float16 is a good choice on CUDA
# OLLAMA_TIMEOUT_SECONDS=300
# CHROMA_COLLECTION=meeting_transcripts
# RAG_CHUNK_SIZE=5
# RAG_CHUNK_OVERLAP=1
# RAG_TOP_K=5
# ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,mp4,webm
# LOG_LEVEL=INFO
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
